rules_version = '2';

// Security rules for PentiaChat. Paste into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Predefined rooms: signed-in users can read them, and may only bump
    // lastMessageAt to the server time when they send a message
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time;

      // Messages: anyone signed in can read; you can only post as yourself,
      // with text and/or a small image and the server time. No edits or deletes
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.image == null
            || (request.resource.data.image is string
              && request.resource.data.image.size() < 750000))
          && (request.resource.data.text.size() > 0
            || request.resource.data.image != null)
          && request.resource.data.createdAt == request.time;
      }
    }

    // Each user's yes/no answer for push notifications per room. Private to the user
    match /users/{userId}/roomNotifications/{roomId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
